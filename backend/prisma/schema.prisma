generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  pending
  payment_pending
  paid
  processing
  shipped
  delivered
  cancelled
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum InventoryReservationStatus {
  none
  reserved
  committed
  released
}

enum DeliveryStatus {
  pending
  ready_for_dispatch
  out_for_delivery
  delivered
  delivery_failed
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  description String   @db.Text
  category    String   @db.VarChar(100)
  gender      String   @db.VarChar(20)
  basePrice   Int
  imageUrl    String   @db.VarChar(500)
  imageAlt    String   @db.VarChar(255)
  featured    Boolean  @default(false)
  newArrival  Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants ProductVariant[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  firstName    String   @db.VarChar(100)
  lastName     String   @db.VarChar(100)
  phone        String?  @db.VarChar(20)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]
  orders   Order[]
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  displayName  String   @db.VarChar(100)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions             AdminSession[]
  inventoryAdjustments InventoryAdjustment[]
  statusHistory        OrderStatusHistory[]
  deliveryStatusHistory DeliveryStatusHistory[]
}

model AdminSession {
  id        String    @id @default(cuid())
  adminId   String
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.VarChar(64)
  csrfToken String    @db.VarChar(128)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([adminId, expiresAt])
  @@index([expiresAt])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.VarChar(64)
  csrfToken String    @db.VarChar(128)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model ProductVariant {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String   @db.VarChar(20)
  color     String   @db.VarChar(50)
  price     Int
  stock     Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems           OrderItem[]
  inventoryAdjustments InventoryAdjustment[]

  @@unique([productId, size, color])
  @@index([productId])
  @@index([active])
  @@index([stock])
}

model InventoryAdjustment {
  id               String         @id @default(cuid())
  productVariantId Int
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  adminId          String
  admin            Admin          @relation(fields: [adminId], references: [id], onDelete: Restrict)
  delta            Int
  previousStock    Int
  resultingStock   Int
  reason           String         @db.VarChar(500)
  createdAt        DateTime       @default(now())

  @@index([productVariantId, createdAt])
  @@index([adminId, createdAt])
}

model Order {
  id                            String                     @id @default(cuid())
  userId                        String?
  user                          User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerEmail                 String                     @db.VarChar(255)
  firstName                     String                     @db.VarChar(100)
  lastName                      String                     @db.VarChar(100)
  phone                         String                     @db.VarChar(20)
  shippingAddress               String                     @db.Text
  city                          String                     @db.VarChar(100)
  state                         String                     @db.VarChar(100)
  country                       String                     @db.VarChar(100)
  subtotal                      Int
  deliveryAmount                Int                        @default(0)
  totalAmount                   Int
  orderStatus                   OrderStatus                @default(pending)
  paymentStatus                 PaymentStatus              @default(pending)
  paymentReference              String?                    @unique @db.VarChar(100)
  inventoryReservationStatus    InventoryReservationStatus @default(none)
  inventoryReservationExpiresAt DateTime?
  paymentReconciliationRequired Boolean                    @default(false)
  paystackTransactionId         String?                    @db.VarChar(100)
  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt

  items        OrderItem[]
  statusHistory OrderStatusHistory[]
  delivery     Delivery?

  @@index([inventoryReservationStatus, inventoryReservationExpiresAt])
  @@index([userId, createdAt])
  @@index([orderStatus, createdAt])
  @@index([paymentStatus, createdAt])
}

model OrderStatusHistory {
  id             String      @id @default(cuid())
  orderId        String
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  adminId        String?
  admin          Admin?      @relation(fields: [adminId], references: [id], onDelete: Restrict)
  previousStatus OrderStatus
  newStatus      OrderStatus
  reason         String?     @db.VarChar(500)
  createdAt      DateTime    @default(now())

  @@index([orderId, createdAt])
  @@index([adminId, createdAt])
}

model Delivery {
  id                     String                  @id @default(cuid())
  orderId                String                  @unique
  order                  Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  deliveryFee            Int                     @default(0)
  status                 DeliveryStatus          @default(pending)
  provider               String?                 @db.VarChar(100)
  trackingNumber         String?                 @db.VarChar(255)
  reference              String?                 @db.VarChar(255)
  estimatedDeliveryDate  DateTime?
  dispatchedAt           DateTime?
  deliveredAt            DateTime?
  failedReason           String?                 @db.VarChar(500)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  statusHistory          DeliveryStatusHistory[]

  @@index([status, createdAt])
}

model DeliveryStatusHistory {
  id             String        @id @default(cuid())
  deliveryId     String
  delivery       Delivery      @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  adminId        String
  admin          Admin          @relation(fields: [adminId], references: [id], onDelete: Restrict)
  previousStatus DeliveryStatus
  newStatus      DeliveryStatus
  reason         String?       @db.VarChar(500)
  createdAt      DateTime      @default(now())

  @@index([deliveryId, createdAt])
  @@index([adminId, createdAt])
}

model OrderItem {
  id               String         @id @default(cuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productVariantId Int
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  productName      String         @db.VarChar(255)
  selectedSize     String         @db.VarChar(20)
  selectedColor    String         @db.VarChar(50)
  quantity         Int            @default(1)
  unitPrice        Int
  lineTotal        Int
  createdAt        DateTime       @default(now())

  @@index([orderId])
  @@index([productVariantId])
  @@index([createdAt])
}
