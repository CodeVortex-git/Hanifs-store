# HANIF'S STORE — backend environment variables (EXAMPLE FILE ONLY)
#
# Copy this file to backend/.env for local development. That real file is
# gitignored and must never be committed.
#
# IMPORTANT: the values below are placeholders. Never place a real secret key in
# this example file or anywhere in frontend JavaScript. Secret credentials are
# read on the server only.

# Port the Express API listens on (development fallback in code is 5000).
PORT=5000

# Comma-separated list of origins allowed to call the API from a browser.
# Leave empty to use the built-in local development defaults
# (http://localhost:3000, http://localhost:5500, http://127.0.0.1:3000,
# http://127.0.0.1:5500). Set this explicitly for deployed environments.
CORS_ORIGINS=

# Paystack secret key — PLACEHOLDER ONLY, not a real key.
# Payment integration is not active in this milestone and this value is not
# currently read by any code path. It will be read from the backend environment
# when the payment milestone is implemented, and must never be sent to or
# referenced by the frontend.
PAYSTACK_SECRET_KEY=your_secret_key_here
